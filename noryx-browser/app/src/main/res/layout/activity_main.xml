<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/back" android:text="‹" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/forward" android:text="›" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/address" android:hint="URL o ricerca" android:singleLine="true" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/reload" android:text="↻" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/home" android:text="⌂" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/errorMessage" android:text="Impossibile caricare la pagina." android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/retry" android:text="Riprova" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
